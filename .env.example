# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yatharth?retryWrites=true&w=majority

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# The password for /admin. Pick a long random one (24+ characters) and keep it private.
ADMIN_SECRET=change-me-to-a-long-random-string

# Your live address, no trailing slash (used in sitemap, OpenGraph and WhatsApp links)
NEXT_PUBLIC_SITE_URL=https://yatharth-dream-devlopers.vercel.app
